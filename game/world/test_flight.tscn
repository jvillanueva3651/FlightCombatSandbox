[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

// Flat test ground: a line every cell_size meters, about a pixel wide,
// fading out in the distance before the lines start to shimmer.
uniform vec3 ground_color : source_color = vec3(0.33, 0.37, 0.3);
uniform vec3 line_color : source_color = vec3(0.6, 0.64, 0.56);
uniform float cell_size = 100.0;

void fragment() {
	vec2 cell = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xz / cell_size;
	vec2 cells_per_pixel = fwidth(cell);
	vec2 pixels_to_line = abs(fract(cell - 0.5) - 0.5) / cells_per_pixel;
	vec2 lines = (1.0 - min(pixels_to_line, vec2(1.0))) * (1.0 - smoothstep(0.05, 0.3, cells_per_pixel));
	ALBEDO = mix(ground_color, line_color, max(lines.x, lines.y));
	ROUGHNESS = 0.9;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grid"]
